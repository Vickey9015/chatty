# Local development only: cp .env.example .env
# Do not upload this file to Hostinger — copy each variable into hPanel → Node.js app → Environment variables (see HOSTINGER.md).
NODE_ENV=production
PORT=3001

# Your public site URL (for CORS if frontend is on another domain)
# CLIENT_URL=https://lockychat.com

# MySQL — local dev uses lockychat_db (auto-created on first start).
# Hostinger: create the database in hPanel, then set DB_* to your u123456789_* values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_lockychat_db
# If password contains @ or special chars, quote it in hPanel: "your@password"
DB_PASSWORD=your_mysql_password_here
DB_NAME=u123456789_lockychat_db

# Optional: dedicated TURN server (set in Hostinger build env for reliable same-WiFi calls)
# VITE_TURN_URL=turn:your-turn.example.com:3478
# VITE_TURN_USERNAME=your_turn_user
# VITE_TURN_CREDENTIAL=your_turn_password

# Recommended for same-WiFi calls — free 20GB/month at https://dashboard.metered.ca/signup
# After signup: Dashboard → Create credential → copy API key here (server env, not VITE_)
# METERED_TURN_API_KEY=your_metered_api_key
# METERED_TURN_API_URL=https://openrelayproject.metered.ca
