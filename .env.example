# Copy to .env on your server: cp .env.example .env
NODE_ENV=production
PORT=3001

# Your public site URL (for CORS if frontend is on another domain)
# CLIENT_URL=https://lockychat.com

# MySQL — database lockychat_db is created automatically on first start
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lockychat_db
